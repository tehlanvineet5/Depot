<% if line_item == @current_item %>
  <tr class="line-item-highlight">
<% else %>
  <tr>
<% end %>
  <td class="text-right">
    <%= line_item.quantity %>
  </td>

  <td>&times;</td>

  <td class="pr-2">
    <%= line_item.product.title %>
  </td>

  <td class="text-right font-bold">
    <%= number_to_currency(line_item.total_price) %>
  </td>

    <% if local_assigns[:show_remove_button] %>
      <td class="pl-3">
        <%= button_to "Remove",
            line_item_path(line_item),
            method: :delete,
            data: { turbo_confirm: "Remove this item?" },
            class: "text-red-600 hover:text-red-800 font-medium" %>
      </td>
    <% end %>
</tr>